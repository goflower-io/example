package views

import "fmt"
import "net/url"
import "github.com/goflower-io/golib/net/app"
import "github.com/goflower-io/example/sqlite/api"




// _userSvcPath is the HTTP route prefix for all User handlers.
// Change the value if your proto uses a package prefix, e.g. "/mypkg.UserService".
const _userSvcPath = "/UserService"

// ─── Layout ───────────────────────────────────────────────────────────────────

// UserShell is the page layout. Customise the <head> (title, CDN links)
// and surrounding chrome (nav, footer) here.
//
// Recommended additions:
//
//	<script src="https://cdn.tailwindcss.com"></script>
//	<script src="https://unpkg.com/htmx.org@2"></script>
templ UserShell() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>User</title>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

// ─── List ─────────────────────────────────────────────────────────────────────

// UserListPage renders the full page (Shell + list view).
templ UserListPage(resp *api.ListUsersResp, path string, form url.Values) {
	@UserShell() {
		@UserListView(resp, path, form)
	}
}

// UserListView is the HTMX-swappable list fragment.
// HTMX target id: "user-list"
templ UserListView(resp *api.ListUsersResp, path string, form url.Values) {
	<div id="user-list">
		<div>
			<h2>User</h2>
			<a href={ templ.SafeURL(_userSvcPath + "/CreateUser") }>New</a>
		</div>
		<table>
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Age</th>
					<th>Ctime</th>
					<th>Mtime</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, a := range resp.GetUsers() {
					@UserItemView(a)
				}
			</tbody>
		</table>
		@userPaginationView(app.CaculatePaginator(resp.GetPage(), resp.GetPageSize(), resp.GetTotalCount()), path)
	</div>
}

// UserItemView renders a single table row with View / Edit / Delete actions.
templ UserItemView(a *api.User) {
	<tr>
		<td>{ fmt.Sprint(a.GetId()) }</td>
		<td>{ fmt.Sprint(a.GetName()) }</td>
		<td>{ fmt.Sprint(a.GetAge()) }</td>
		<td>{ fmt.Sprint(a.GetCtime()) }</td>
		<td>{ fmt.Sprint(a.GetMtime()) }</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf(_userSvcPath+"/GetUser?Id=%v", a.GetId())) }>View</a>
			<a href={ templ.SafeURL(fmt.Sprintf(_userSvcPath+"/UpdateUser?Id=%v", a.GetId())) }>Edit</a>
			<button
				hx-delete={ fmt.Sprintf(_userSvcPath+"/DeleteUser?Id=%v", a.GetId()) }
				hx-confirm="Delete this User?"
				hx-target="#user-list"
				hx-swap="outerHTML"
				hx-push-url="false"
			>Delete</button>
		</td>
	</tr>
}

// ─── ListMore (cursor-based infinite scroll) ──────────────────────────────────

// UserListMorePage renders the full infinite-scroll page (Shell + initial batch).
templ UserListMorePage(resp *api.ListUsersMoreResp, path string, pageSize int32) {
	@UserShell() {
		<table>
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Age</th>
					<th>Ctime</th>
					<th>Mtime</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody id="user-more-list">
				@UserListMoreView(resp, path, pageSize)
			</tbody>
		</table>
	}
}

// UserListMoreView renders a batch of rows plus the sentinel row for the next load.
// HTMX swaps this fragment into "#user-more-list" (outerHTML of the sentinel).
templ UserListMoreView(resp *api.ListUsersMoreResp, path string, pageSize int32) {
	for _, a := range resp.GetUsers() {
		@UserItemView(a)
	}
	@userLoadMoreSentinel(resp.GetNextPageToken(), resp.GetHasMore(), path, pageSize)
}

// userLoadMoreSentinel is the invisible trigger row appended after each batch.
// When it enters the viewport, HTMX fetches the next page and replaces this row
// with the new rows + a fresh sentinel. Renders nothing when has_more is false.
templ userLoadMoreSentinel(nextPageToken string, hasMore bool, path string, pageSize int32) {
	if hasMore {
		<tr
			hx-get={ fmt.Sprintf("%s/ListUsersMore?page_token=%s&page_size=%d", path, nextPageToken, pageSize) }
			hx-trigger="intersect once"
			hx-target="this"
			hx-swap="outerHTML"
		></tr>
	}
}

// ─── Detail ───────────────────────────────────────────────────────────────────

// UserDetailPage renders the full detail page.
templ UserDetailPage(a *api.User) {
	@UserShell() {
		@UserDetailView(a)
	}
}

// UserDetailView renders a definition list of all fields.
templ UserDetailView(a *api.User) {
	<div>
		<dl>
			<div>
				<dt>Id</dt>
				<dd>{ fmt.Sprint(a.GetId()) }</dd>
			</div>
			<div>
				<dt>Name</dt>
				<dd>{ fmt.Sprint(a.GetName()) }</dd>
			</div>
			<div>
				<dt>Age</dt>
				<dd>{ fmt.Sprint(a.GetAge()) }</dd>
			</div>
			<div>
				<dt>Ctime</dt>
				<dd>{ fmt.Sprint(a.GetCtime()) }</dd>
			</div>
			<div>
				<dt>Mtime</dt>
				<dd>{ fmt.Sprint(a.GetMtime()) }</dd>
			</div>
		</dl>
		<div>
			<a href={ templ.SafeURL(fmt.Sprintf(_userSvcPath+"/UpdateUser?Id=%v", a.GetId())) }>Edit</a>
			<a href={ templ.SafeURL(_userSvcPath + "/ListUsers") }>Back</a>
		</div>
	</div>
}

// ─── Create ───────────────────────────────────────────────────────────────────

// UserCreatePage renders the full create page.
templ UserCreatePage() {
	@UserShell() {
		@UserCreateView()
	}
}

// UserCreateView renders the create form (HTMX-swappable fragment).
// On success the server returns a new fragment replacing this form.
templ UserCreateView() {
	<form
		hx-put={ _userSvcPath + "/CreateUser" }
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<label for="Name">Name</label>
			<input type="text" id="Name" name="Name"/>
		</div>
		<div>
			<label for="Age">Age</label>
			<input type="number" id="Age" name="Age"/>
		</div>
		<div>
			<label for="Ctime">Ctime</label>
			<input type="text" id="Ctime" name="Ctime"/>
		</div>
		<div>
			<label for="Mtime">Mtime</label>
			<input type="text" id="Mtime" name="Mtime"/>
		</div>
		<button type="submit">Create</button>
	</form>
}

// ─── Update ───────────────────────────────────────────────────────────────────

// UserUpdatePage renders the full update page.
templ UserUpdatePage(a *api.User) {
	@UserShell() {
		@UserUpdateView(a)
	}
}

// UserUpdateView renders the update form (HTMX-swappable fragment).
//
// Changed fields are tracked via hidden Masks checkboxes that mirror the
// proto UserField enum values. Each input's hx-on:change handler
// automatically checks the corresponding mask before form submission,
// so only modified fields are sent to the server.
templ UserUpdateView(a *api.User) {
	<form
		hx-post={ fmt.Sprintf(_userSvcPath+"/UpdateUser?User.Id=%v", a.GetId()) }
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div>
			<label for="Id">Id</label>
			<input
				type="text"
				id="Id"
				name="User.Id"
				value={ fmt.Sprint(a.GetId()) }
				disabled
			/>
		</div>
		<div>
			<label for="User.Name">Name</label>
			<input
				type="text"
				id="User.Name"
				name="User.Name"
				value={ fmt.Sprint(a.GetName()) }
				hx-on:change="document.getElementById('mask_2').checked=true"
			/>
			<input type="checkbox" id="mask_2" name="Masks" value="2" hidden/>
		</div>
		<div>
			<label for="User.Age">Age</label>
			<input
				type="number"
				id="User.Age"
				name="User.Age"
				value={ fmt.Sprint(a.GetAge()) }
				hx-on:change="document.getElementById('mask_3').checked=true"
			/>
			<input type="checkbox" id="mask_3" name="Masks" value="3" hidden/>
		</div>
		<div>
			<label for="User.Ctime">Ctime</label>
			<input
				type="text"
				id="User.Ctime"
				name="User.Ctime"
				value={ fmt.Sprint(a.GetCtime()) }
				hx-on:change="document.getElementById('mask_4').checked=true"
			/>
			<input type="checkbox" id="mask_4" name="Masks" value="4" hidden/>
		</div>
		<div>
			<label for="User.Mtime">Mtime</label>
			<input
				type="text"
				id="User.Mtime"
				name="User.Mtime"
				value={ fmt.Sprint(a.GetMtime()) }
				hx-on:change="document.getElementById('mask_5').checked=true"
			/>
			<input type="checkbox" id="mask_5" name="Masks" value="5" hidden/>
		</div>
		<button type="submit">Update</button>
	</form>
}

// ─── Pagination (package-private) ────────────────────────────────────────────

// userPaginationView renders prev / page-numbers / next navigation.
// HTMX requests replace the "#user-list" target and update the browser URL.
templ userPaginationView(p *app.Paginator, path string) {
	<nav>
		if p.Pre > 0 {
			<a
				hx-get={ fmt.Sprintf("%s/ListUsers?page=%d&page_size=%d", path, p.Pre, p.PageSize) }
				hx-target="#user-list"
				hx-swap="outerHTML"
				hx-push-url="true"
			>Prev</a>
		}
		for _, pg := range p.Pages {
			if pg == p.CurrentPage {
				<span>{ fmt.Sprint(pg) }</span>
			} else {
				<a
					hx-get={ fmt.Sprintf("%s/ListUsers?page=%d&page_size=%d", path, pg, p.PageSize) }
					hx-target="#user-list"
					hx-swap="outerHTML"
					hx-push-url="true"
				>{ fmt.Sprint(pg) }</a>
			}
		}
		if p.Next <= p.TotalPage {
			<a
				hx-get={ fmt.Sprintf("%s/ListUsers?page=%d&page_size=%d", path, p.Next, p.PageSize) }
				hx-target="#user-list"
				hx-swap="outerHTML"
				hx-push-url="true"
			>Next</a>
		}
	</nav>
}
